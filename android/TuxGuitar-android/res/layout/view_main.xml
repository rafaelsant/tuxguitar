<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: the score, the floating menu bar and the player sheet are drawn with Compose (TGMainScreen in
     TGBottomBars.kt, a Material BottomSheetScaffold); the tab keyboard of edit mode sits below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/main_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_tab_keyboard" />

</LinearLayout>
