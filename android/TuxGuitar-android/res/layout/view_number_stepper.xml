<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:gravity="center_vertical" >

	<Button
		android:id="@+id/number_stepper_decrease"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:minWidth="0dp"
		android:minHeight="0dp"
		android:padding="0dp"
		android:text="@string/number_stepper_decrease"
		android:contentDescription="@string/number_stepper_decrease_description"
		android:textSize="24sp" />

	<EditText
		android:id="@+id/number_stepper_value"
		android:layout_width="88dp"
		android:layout_height="56dp"
		android:gravity="center"
		android:inputType="number"
		android:imeOptions="actionDone"
		android:selectAllOnFocus="true"
		android:maxLength="4"
		android:importantForAutofill="no"
		android:textSize="20sp" />

	<Button
		android:id="@+id/number_stepper_increase"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:minWidth="0dp"
		android:minHeight="0dp"
		android:padding="0dp"
		android:text="@string/number_stepper_increase"
		android:contentDescription="@string/number_stepper_increase_description"
		android:textSize="24sp" />
</LinearLayout>
